{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workflow_plan.schema.json",
  "title": "Workflow plan",
  "description": "User-approved modeling plan. Where a field overlaps the prediction contract (e.g. ml_domain), the plan wins.",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "modeling_plan", "preprocessing_plan", "steps"],
  "properties": {
    "objective": {"type": "string", "minLength": 1},
    "modeling_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_models", "validation_strategy", "primary_metric"],
      "properties": {
        "candidate_models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "rationale"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "library": {"type": "string"},
              "rationale": {"type": "string", "minLength": 1},
              "search_space": {"type": "object"}
            }
          }
        },
        "validation_strategy": {"type": "string", "minLength": 1},
        "primary_metric": {"type": "string", "minLength": 1},
        "selection_criteria": {"type": "string"},
        "class_imbalance_strategy": {"type": "string"}
      }
    },
    "preprocessing_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drop_columns"],
      "properties": {
        "engine": {
          "enum": ["parity-ml", "open_source"],
          "default": "parity-ml",
          "description": "Selects parity-ml-preprocessing (default when absent) vs data-preprocessing."
        },
        "drop_columns": {"type": "array", "items": {"type": "string"}},
        "categorical_encoding": {"type": "string"},
        "numeric_scaling": {"type": "string"},
        "imputation": {"type": "string"},
        "engineered_features": {"type": "array", "items": {"type": "string"}}
      }
    },
    "parity_requirements": {
      "type": "object",
      "description": "Only for production_parity / parity-ml: what the exported ONNX must match.",
      "properties": {
        "max_abs_diff": {"type": "number", "exclusiveMinimum": 0},
        "n_samples": {"type": "integer", "minimum": 1},
        "opset": {"type": "integer", "minimum": 1},
        "notes": {"type": "string"}
      }
    },
    "distributed_training_plan": {
      "type": "object",
      "description": "Only when scale_assumption is large_data_distributed_tbd. Extension point; runtime wiring is environment-specific.",
      "required": ["backend"],
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "cluster": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "ml_domain": {"enum": ["credit_risk", null]},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "compute_notes": {"type": "string"},
    "notes": {"type": "string"}
  }
}

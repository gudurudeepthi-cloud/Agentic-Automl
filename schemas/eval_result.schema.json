{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "eval_result.schema.json",
  "title": "Eval result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "dataset_id", "run_id", "runner", "status", "started_at",
               "ended_at", "elapsed_seconds", "artifact_snapshot", "scores", "process_metrics", "cost", "logs"],
  "properties": {
    "schema_version": {"const": 1},
    "scenario_id": {"type": "string"},
    "dataset_id": {"type": "string"},
    "run_id": {"type": "string"},
    "tier": {"type": "string"},
    "runner": {"enum": ["deterministic", "claude"]},
    "status": {"enum": ["pass", "fail", "harness-error", "harness-unavailable", "incomplete", "environment-unavailable"]},
    "stop_reason": {"type": ["string", "null"]},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "trial_dir": {"type": ["string", "null"]},
    "artifact_snapshot": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "scores": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "passed", "detail"],
        "properties": {"name": {"type": "string"}, "passed": {"type": "boolean"}, "detail": {"type": "string"}}
      }
    },
    "process_metrics": {"type": "object"},
    "cost": {"type": "object"},
    "logs": {"type": "object"}
  }
}

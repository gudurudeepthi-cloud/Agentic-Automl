{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evaluation_summary.schema.json",
  "title": "Evaluation summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_evaluated", "split_evaluated", "primary_metric",
    "primary_metric_value", "metrics", "baseline_comparison", "plots",
    "trust_checks", "narrative", "findings", "evaluation_script"
  ],
  "properties": {
    "model_evaluated": {"type": "string", "minLength": 1},
    "split_evaluated": {"type": "string", "minLength": 1},
    "primary_metric": {"type": "string", "minLength": 1},
    "primary_metric_value": {"type": "number"},
    "metrics": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["number", "null"]}},
    "baseline_comparison": {"type": ["object", "null"]},
    "threshold": {"type": ["number", "null"]},
    "per_segment": {"type": "object"},
    "trust_checks": {
      "type": "array",
      "minItems": 1,
      "description": "Sanity checks on the result (leakage, too-good-to-be-true, label balance, split integrity).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "narrative": {"type": "string", "minLength": 1, "description": "Plain-language summary for the business stakeholder."},
    "plots": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evaluation_script": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "explainability_summary.schema.json",
  "title": "Explainability summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["method", "global_importance", "plots", "findings", "explainability_script"],
  "properties": {
    "method": {"type": "string", "minLength": 1},
    "global_importance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "importance"],
        "properties": {
          "feature": {"type": "string", "minLength": 1},
          "importance": {"type": "number"}
        }
      }
    },
    "plots": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "explainability_script": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}

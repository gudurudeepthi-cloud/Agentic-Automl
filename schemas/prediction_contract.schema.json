{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "prediction_contract.schema.json",
  "title": "Prediction contract",
  "description": "User-approved problem definition. Problem semantics are free strings; enums exist only where gates or infrastructure branch on the value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_type", "target_kind", "business_context", "deployment_intent",
    "dataset_path", "dataset_location", "data_source", "data_segments",
    "schema_files", "split_strategy", "split_column", "split_train_value",
    "split_test_value", "time_column", "split_ratio", "target_column",
    "target_labels", "entity_id_column", "weight_column", "primary_metric",
    "report_metrics", "model_preference", "model_space", "scale_assumption"
  ],
  "definitions": {
    "nullable_string": {"type": ["string", "null"], "minLength": 1},
    "split_value": {"type": ["string", "number", "integer", "boolean", "null"]},
    "null": {"type": "null"}
  },
  "properties": {
    "task_type": {"type": "string", "minLength": 1, "description": "Free-form task description, e.g. 'churn classification'."},
    "target_kind": {"enum": ["binary", "multiclass", "continuous", "other"]},
    "business_context": {"type": "string", "minLength": 1},
    "deployment_intent": {"enum": ["exploratory_baseline", "production_parity"]},
    "dataset_path": {"type": "string", "minLength": 1},
    "dataset_location": {"enum": ["local", "gcs"], "description": "Inferred from a gs:// prefix on dataset_path."},
    "data_source": {"enum": ["internal", "external"]},
    "data_segments": {
      "type": "array",
      "minItems": 1,
      "description": "Physical data files/directories. Either one 'full' segment (split by split_strategy) or both 'train' and 'test'.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "format", "role", "file_count"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1, "description": "e.g. csv, parquet, jsonl."},
          "role": {"enum": ["train", "test", "full", "other"]},
          "file_count": {"type": "integer", "minimum": 1}
        }
      },
      "oneOf": [
        {"contains": {"properties": {"role": {"const": "full"}}}},
        {
          "allOf": [
            {"contains": {"properties": {"role": {"const": "train"}}}},
            {"contains": {"properties": {"role": {"const": "test"}}}}
          ]
        }
      ]
    },
    "schema_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "split_strategy": {"enum": ["pre_split", "predefined_column", "temporal", "random_stratified", "random"]},
    "split_column": {"$ref": "#/definitions/nullable_string"},
    "split_train_value": {"$ref": "#/definitions/split_value"},
    "split_test_value": {"$ref": "#/definitions/split_value"},
    "time_column": {"$ref": "#/definitions/nullable_string"},
    "split_ratio": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1, "description": "Held-out test fraction."},
    "target_column": {"type": "string", "minLength": 1},
    "target_labels": {"type": ["array", "null"], "items": {"type": ["string", "number", "integer", "boolean"]}},
    "entity_id_column": {"$ref": "#/definitions/nullable_string"},
    "weight_column": {"$ref": "#/definitions/nullable_string"},
    "primary_metric": {"type": "string", "minLength": 1},
    "report_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "model_preference": {"enum": ["single_baseline", "user_specified", "auto_research"], "description": "auto_research injects the auto-research skill between training and evaluation."},
    "model_space": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1}},
    "scale_assumption": {"enum": ["local_workstation", "large_data_distributed_tbd"]},
    "ml_domain": {"enum": ["credit_risk", null], "description": "Optional overlay key; must match .claude/skills/domains/registry.json."},
    "research_max_experiments": {"type": "integer", "minimum": 1, "description": "auto-research budget; defaults to 15 when absent."},
    "project_name": {"type": "string", "minLength": 1, "description": "The user's name for the project or use case."},
    "prediction_point": {"type": "string", "minLength": 1, "description": "When the prediction is made and what is known at that moment, e.g. 'at authorisation, before any chargeback'."},
    "required_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Columns the user wants kept as features; feature selection never removes them."},
    "excluded_columns": {
      "type": "array",
      "description": "Columns the user says must not be features (known only after the outcome, not available at prediction time, PII, policy).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["column", "reason"],
        "properties": {
          "column": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "intake_answers": {
      "type": "array",
      "description": "The intake interview as asked: each question, the user's answer, and whether the answer was the agent's proposal confirmed or the user's own.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1},
          "source": {"enum": ["user", "confirmed_proposal", "default"]}
        }
      }
    },
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"dataset_location": {"const": "gcs"}}},
      "then": {"properties": {"dataset_path": {"pattern": "^gs://"}}},
      "else": {"properties": {"dataset_path": {"not": {"pattern": "^gs://"}}}}
    },
    {
      "if": {"properties": {"split_strategy": {"const": "temporal"}}},
      "then": {
        "properties": {
          "time_column": {"type": "string"},
          "split_ratio": {"type": "number"},
          "split_column": {"$ref": "#/definitions/null"},
          "split_train_value": {"$ref": "#/definitions/null"},
          "split_test_value": {"$ref": "#/definitions/null"}
        }
      }
    },
    {
      "if": {"properties": {"split_strategy": {"const": "predefined_column"}}},
      "then": {
        "properties": {
          "split_column": {"type": "string"},
          "split_train_value": {"not": {"type": "null"}},
          "split_test_value": {"not": {"type": "null"}},
          "split_ratio": {"$ref": "#/definitions/null"},
          "time_column": {"$ref": "#/definitions/null"}
        }
      }
    },
    {
      "if": {"properties": {"split_strategy": {"enum": ["random", "random_stratified"]}}},
      "then": {
        "properties": {
          "split_ratio": {"type": "number"},
          "split_column": {"$ref": "#/definitions/null"},
          "split_train_value": {"$ref": "#/definitions/null"},
          "split_test_value": {"$ref": "#/definitions/null"},
          "time_column": {"$ref": "#/definitions/null"}
        }
      }
    },
    {
      "if": {"properties": {"split_strategy": {"const": "pre_split"}}},
      "then": {
        "properties": {
          "split_ratio": {"$ref": "#/definitions/null"},
          "split_column": {"$ref": "#/definitions/null"},
          "split_train_value": {"$ref": "#/definitions/null"},
          "split_test_value": {"$ref": "#/definitions/null"},
          "time_column": {"$ref": "#/definitions/null"}
        }
      }
    },
    {
      "if": {"properties": {"target_kind": {"const": "binary"}}},
      "then": {"properties": {"target_labels": {"type": "array", "minItems": 2, "maxItems": 2}}}
    },
    {
      "if": {"properties": {"target_kind": {"const": "multiclass"}}},
      "then": {"properties": {"target_labels": {"type": "array", "minItems": 3}}}
    },
    {
      "if": {"properties": {"target_kind": {"const": "continuous"}}},
      "then": {"properties": {"target_labels": {"$ref": "#/definitions/null"}}}
    },
    {
      "if": {"properties": {"model_preference": {"const": "user_specified"}}},
      "then": {"properties": {"model_space": {"type": "array", "minItems": 1}}}
    },
    {
      "if": {
        "properties": {
          "model_preference": {"const": "single_baseline"},
          "deployment_intent": {"const": "exploratory_baseline"}
        }
      },
      "then": {"properties": {"model_space": {"$ref": "#/definitions/null"}}}
    }
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "training_summary.schema.json",
  "title": "Training summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "models", "selected_model", "selection_rationale", "primary_metric",
    "cv_strategy", "training_script", "model_artifact_path"
  ],
  "properties": {
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "library", "hyperparameters", "cv_score"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "library": {"type": "string", "minLength": 1},
          "hyperparameters": {"type": "object"},
          "cv_score": {"type": ["number", "null"]},
          "cv_score_std": {"type": ["number", "null"]},
          "train_time_seconds": {"type": ["number", "null"], "minimum": 0},
          "artifact_path": {"type": "string"}
        }
      }
    },
    "selected_model": {"type": "string", "minLength": 1},
    "selection_rationale": {"type": "string", "minLength": 1},
    "primary_metric": {"type": "string", "minLength": 1},
    "cv_strategy": {"type": "string", "minLength": 1},
    "training_script": {"type": "string", "minLength": 1},
    "model_artifact_path": {"type": "string", "minLength": 1},
    "random_seed": {"type": ["integer", "null"]},
    "notes": {"type": "string"}
  }
}

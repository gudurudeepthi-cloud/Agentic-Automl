{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "benchmark_dataset.schema.json",
  "title": "Benchmark dataset registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "access", "brief", "dataset_format"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "status": {"enum": ["draft", "active", "retired"]},
    "access": {"enum": ["public_download", "generated", "gcs", "manual"]},
    "brief": {"type": "string", "minLength": 1},
    "owner": {"type": "string"},
    "owner_confirmed": {"type": "boolean"},
    "task_type": {"enum": ["binary", "multiclass", "continuous"]},
    "target_variable": {"type": "string"},
    "positive_label": {"type": ["string", "number", "integer", "boolean", "null"]},
    "primary_metric": {"type": "string"},
    "secondary_metrics": {"type": "array", "items": {"type": "string"}},
    "dataset_format": {"enum": ["csv", "parquet", "jsonl"]},
    "download_url": {"type": ["string", "null"]},
    "download_urls": {"type": "array", "items": {"type": "string"}},
    "generator": {"type": "object", "description": "For access=generated: {script, args}."},
    "source": {"type": "string"},
    "license": {"type": "string"},
    "notes": {"type": "string"},
    "split": {"type": "object", "description": "Contract split fields (split_strategy, time_column, split_ratio, ...)."},
    "entity_id_column": {"type": ["string", "null"]},
    "id_columns": {"type": "array", "items": {"type": "string"}},
    "drop_columns": {"type": "array", "items": {"type": "string"}},
    "business_context": {"type": "string"},
    "gcs_paths": {"type": "object", "properties": {"staging": {"type": "string", "pattern": "^gs://"}}},
    "features": {"type": "string", "description": "Path to features.json relative to the repo."},
    "sizing": {"type": "string", "description": "Path to sizing.json relative to the repo."},
    "smoke_rows": {"type": "integer", "minimum": 100},
    "performance": {
      "type": "object",
      "properties": {
        "automl_best": {
          "type": "object",
          "properties": {"metric": {"type": "string"}, "value": {"type": "number"}, "source": {"type": "string"}}
        },
        "expected_band": {"type": "object", "properties": {"min": {"type": "number"}, "max": {"type": "number"}}}
      }
    }
  }
}

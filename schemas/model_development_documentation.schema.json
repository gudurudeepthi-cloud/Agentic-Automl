{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model_development_documentation.schema.json",
  "title": "Model development documentation",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_path", "summary", "sections", "limitations"],
  "properties": {
    "document_path": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "generated_at": {"type": "string"},
    "notes": {"type": "string"}
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "auto_research_summary.schema.json",
  "title": "Auto-research summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "primary_metric", "baseline_metric", "best_metric", "iterations",
    "best_model_artifact_path", "stop_reason"
  ],
  "properties": {
    "primary_metric": {"type": "string", "minLength": 1},
    "baseline_metric": {"type": "number"},
    "best_metric": {"type": "number"},
    "iterations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iteration", "hypothesis", "change", "metric_value", "kept"],
        "properties": {
          "iteration": {"type": "integer", "minimum": 1},
          "hypothesis": {"type": "string", "minLength": 1},
          "change": {"type": "string", "minLength": 1},
          "metric_value": {"type": ["number", "null"]},
          "kept": {"type": "boolean"},
          "script": {"type": "string"}
        }
      }
    },
    "best_model_artifact_path": {"type": "string", "minLength": 1},
    "stop_reason": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}

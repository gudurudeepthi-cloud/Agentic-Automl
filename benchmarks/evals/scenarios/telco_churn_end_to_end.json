{
  "id": "telco_churn_end_to_end",
  "dataset_id": "telco_churn",
  "data_size": "smoke",
  "answer_bank": [
    {
      "match": "target column",
      "answer": "The target column is Churn (positive class 'Yes')."
    },
    {
      "match": "dataset path",
      "answer": "Use {{REPO_ROOT}}/benchmarks/evals/fixtures/datasets/telco_churn.csv."
    },
    {
      "match": "business context",
      "answer": "Score customers by churn risk for a retention campaign."
    },
    {
      "match": "split",
      "answer": "Use a random_stratified split with 20% held out for test."
    },
    {
      "match": "metric",
      "answer": "Optimise roc_auc; also report pr_auc, log_loss."
    },
    {
      "match": "model preference",
      "answer": "A single baseline model is fine (single_baseline)."
    },
    {
      "match": "deployment",
      "answer": "Exploratory baseline; no production parity needed (open_source engine is fine)."
    },
    {
      "match": "approve",
      "answer": "Yes, approved. Proceed."
    },
    {
      "match": "compute",
      "answer": "Yes, go ahead; keep each run under 10 minutes."
    }
  ],
  "dataset_path": "benchmarks/evals/fixtures/datasets/telco_churn.csv",
  "suite": "e2e",
  "tiers": [
    "e2e",
    "real"
  ],
  "entry_skill": "prediction-contract",
  "seed": {
    "kind": "empty"
  },
  "initial_prompt": "Build a model that predicts which telecom customers will churn, for a retention campaign.",
  "limits": {
    "max_turns": 150,
    "max_budget_usd": 20,
    "timeout_seconds": 5400
  },
  "expected_artifacts": [
    "prediction_contract",
    "dataset_profile",
    "column_profile",
    "workflow_plan",
    "preprocessing_summary",
    "training_summary",
    "evaluation_summary"
  ],
  "invariants": [
    {
      "type": "metric_band",
      "name": "test_roc_auc_in_band",
      "artifact": "evaluation_summary",
      "metric": "primary_metric_value",
      "min": 0.7,
      "max": 0.92
    },
    {
      "type": "file_contains",
      "name": "leakage_check_passed",
      "path": "outputs/report/evaluation_summary.json",
      "patterns": [
        "\"name\": \"leakage\",\\s*\"passed\": true"
      ]
    },
    {
      "type": "file_contains",
      "name": "customerID_dropped",
      "path": "state/workflow_plan.json",
      "patterns": [
        "\"customerID\""
      ]
    },
    {
      "type": "file_contains",
      "name": "customerID_is_id",
      "path": "column_profile.json",
      "patterns": [
        "\"name\": \"customerID\",[^}]*\"role\": \"id\""
      ]
    },
    {
      "type": "file_contains",
      "name": "Churn_is_target",
      "path": "column_profile.json",
      "patterns": [
        "\"name\": \"Churn\",[^}]*\"role\": \"target\""
      ]
    },
    {
      "type": "file_present",
      "name": "feature_selection_ran",
      "path": "outputs/model/feature_selection.json"
    },
    {
      "type": "max_validation_failures",
      "max_count": 4
    }
  ],
  "environment": {
    "requires": [
      "claude",
      "runtime_python"
    ]
  }
}

    {
      "type": "file_contains",
      "name": "Churn_is_target",
      "path": "column_profile.json",
      "patterns": [
        "\"name\": \"Churn\",[^}]*\"role\": \"target\""
      ]
    },
    {
      "type": "file_present",
      "name": "profiling_script_kept",
      "path": "work/profile_dataset.py"

  "dataset_path": "benchmarks/evals/fixtures/datasets/synthetic_fraud.csv",
  "suite": "seeds",
  "tiers": [
    "deterministic"
  ],
  "entry_skill": "evaluation",
  "seed": {
    "kind": "fixture",
    "name": "synthetic_fraud_evaluated"
  },
  "initial_prompt": "Deterministic check of the committed evaluated seed (no agent run).",
  "limits": {
    "max_turns": 1,
    "max_budget_usd": 0,
    "timeout_seconds": 60
  },
  "expected_artifacts": [
    "prediction_contract",
    "dataset_profile",
    "column_profile",
    "workflow_plan",
    "preprocessing_summary",
    "training_summary",
    "evaluation_summary"
  ],
  "invariants": [
    {
      "type": "metric_band",
      "name": "test_pr_auc_in_band",
      "artifact": "evaluation_summary",
      "metric": "primary_metric_value",
      "min": 0.25,
      "max": 0.85
    },
    {
      "type": "file_contains",
      "name": "leakage_check_passed",
      "path": "outputs/report/evaluation_summary.json",
      "patterns": [
        "\"name\": \"leakage\",\\s*\"passed\": true"
      ]
    },
    {
      "type": "file_contains",
      "name": "chargeback_flag_dropped",
      "path": "state/workflow_plan.json",
      "patterns": [
        "\"chargeback_flag\""
      ]
    },
    {
      "type": "file_contains",
      "name": "chargeback_flag_caught_as_leakage",
      "path": "column_profile.json",
      "patterns": [
        "\"name\": \"chargeback_flag\",[^}]*\"role\": \"(leakage_suspect|drop)\""
      ]
    },
    {
      "type": "file_contains",
      "name": "currency_is_drop",
      "path": "column_profile.json",
      "patterns": [
        "\"name\": \"currency\",[^}]*\"role\": \"drop\""
      ]
    },
    {
      "type": "file_contains",
      "name": "transaction_id_is_id",
      "path": "column_profile.json",
      "patterns": [
        "\"name\": \"transaction_id\",[^}]*\"role\": \"id\""
      ]
    },
    {
      "type": "max_validation_failures",
      "max_count": 0
    }
  ],
  "environment": {
    "requires": []
  }
}

    },
    {
      "match": "approve",
      "answer": "Yes, approved. Proceed."
    },
    {
      "match": "compute",
      "answer": "Yes, go ahead; keep each run under 10 minutes."
    },
    {
      "match": "entity",
      "answer": "customer_id identifies the entity; rows repeat per entity."
    },
    {
      "match": "project",
      "answer": "Call it synthetic-fraud."
    },
    {
      "match": "prediction is made",
      "answer": "At scoring time, using only what is recorded before the outcome is known."
    },
    {
      "match": "date column",
      "answer": "event_time timestamps each row; test should be the latest period."
    },
    {
      "match": "must not be used",
      "answer": "I don't know of any; use your judgement and tell me what you exclude."
    },
    {
      "match": "must be kept",
      "answer": "No columns have to be kept."
    },
    {
      "match": "cost of errors",
      "answer": "Rank card transactions so analysts review the riskiest 1% first."
    },
    {
      "match": "weights",
      "answer": "No row weights and no data dictionary."
    },
    {
      "match": "outcome delay",
      "answer": "Labels in this dataset are final; there is no outcome delay to wait for."
    },
    {
      "match": "vintage",
      "answer": "Analyse the vintages and propose a selection; keep all periods unless the evidence says otherwise, and tell me what you exclude."
